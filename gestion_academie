-- ============================================
-- 1. MODÈLE CONCEPTUEL DE DONNÉES (MCD)
-- ============================================
/*
ENTITÉS :
- COLLEGE (id_college, nom_college, site_internet, adresse, ville, code_postal)
- DEPARTEMENT (id_departement, nom_departement)
- ENSEIGNANT (id_enseignant, nom, prenom, tel, mail, date_prise_fonction, indice)
- MATIERE (id_matiere, nom_matiere, coefficient)
- SALLE (id_salle, numero_salle, nb_places, batiment, etage)
- ETUDIANT (id_etudiant, nom, prenom, tel, mail, annee_entree)

RELATIONS :
- COLLEGE possède DEPARTEMENT (1:N)
- DEPARTEMENT regroupe ENSEIGNANT (1:N)
- DEPARTEMENT a pour responsable ENSEIGNANT (1:1)
- ENSEIGNANT dispense MATIERE (N:1) - un enseignant = une seule matière
- ENSEIGNANT enseigne MATIERE via ENSEIGNER (N:N) - une matière peut avoir plusieurs enseignants
- MATIERE a lieu dans SALLE (N:1)
- ETUDIANT suit MATIERE via SUIVRE (N:N) avec attribut note
- COLLEGE accueille ETUDIANT (1:N)
*/

-- ============================================
-- 2. MODÈLE LOGIQUE DE DONNÉES (MLD)
-- ============================================
/*
COLLEGE (id_college, nom_college, site_internet, adresse, ville, code_postal)
SALLE (id_salle, numero_salle, nb_places, batiment, etage)
MATIERE (id_matiere, nom_matiere, coefficient, #id_salle)
DEPARTEMENT (id_departement, nom_departement, #id_college, #id_responsable)
ENSEIGNANT (id_enseignant, nom, prenom, tel, mail, date_prise_fonction, indice, #id_departement, #id_matiere)
ETUDIANT (id_etudiant, nom, prenom, tel, mail, annee_entree, #id_college)
ENSEIGNER (#id_enseignant, #id_matiere, nb_heures)
SUIVRE (#id_etudiant, #id_matiere, note, date_evaluation)
*/

-- ============================================
-- CRÉATION DE LA BASE DE DONNÉES
-- ============================================

DROP DATABASE IF EXISTS gestion_academie;
CREATE DATABASE gestion_academie CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE gestion_academie;

-- ============================================
-- CRÉATION DES TABLES
-- ============================================

-- Table COLLEGE
CREATE TABLE COLLEGE (
    id_college INT AUTO_INCREMENT PRIMARY KEY,
    nom_college VARCHAR(100) NOT NULL,
    site_internet VARCHAR(200),
    adresse VARCHAR(255),
    ville VARCHAR(100),
    code_postal VARCHAR(10)
);

-- Table SALLE
CREATE TABLE SALLE (
    id_salle INT AUTO_INCREMENT PRIMARY KEY,
    numero_salle VARCHAR(20) NOT NULL,
    nb_places INT NOT NULL CHECK (nb_places > 0),
    batiment VARCHAR(50),
    etage INT
);

-- Table MATIERE
CREATE TABLE MATIERE (
    id_matiere INT AUTO_INCREMENT PRIMARY KEY,
    nom_matiere VARCHAR(100) NOT NULL,
    coefficient INT DEFAULT 1,
    id_salle INT NOT NULL,
    FOREIGN KEY (id_salle) REFERENCES SALLE(id_salle)
);

-- Table DEPARTEMENT
CREATE TABLE DEPARTEMENT (
    id_departement INT AUTO_INCREMENT PRIMARY KEY,
    nom_departement VARCHAR(100) NOT NULL,
    id_college INT NOT NULL,
    id_responsable INT,
    FOREIGN KEY (id_college) REFERENCES COLLEGE(id_college)
);

-- Table ENSEIGNANT
CREATE TABLE ENSEIGNANT (
    id_enseignant INT AUTO_INCREMENT PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    tel VARCHAR(20),
    mail VARCHAR(150) UNIQUE,
    date_prise_fonction DATE NOT NULL,
    indice INT,
    id_departement INT NOT NULL,
    id_matiere INT NOT NULL,
    FOREIGN KEY (id_departement) REFERENCES DEPARTEMENT(id_departement),
    FOREIGN KEY (id_matiere) REFERENCES MATIERE(id_matiere)
);

-- Ajout de la clé étrangère pour le responsable du département
ALTER TABLE DEPARTEMENT 
ADD FOREIGN KEY (id_responsable) REFERENCES ENSEIGNANT(id_enseignant);

-- Table ETUDIANT
CREATE TABLE ETUDIANT (
    id_etudiant INT AUTO_INCREMENT PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    tel VARCHAR(20),
    mail VARCHAR(150) UNIQUE,
    annee_entree INT NOT NULL,
    id_college INT NOT NULL,
    FOREIGN KEY (id_college) REFERENCES COLLEGE(id_college)
);

-- Table ENSEIGNER (relation N:N entre ENSEIGNANT et MATIERE)
CREATE TABLE ENSEIGNER (
    id_enseignant INT,
    id_matiere INT,
    nb_heures INT DEFAULT 0,
    PRIMARY KEY (id_enseignant, id_matiere),
    FOREIGN KEY (id_enseignant) REFERENCES ENSEIGNANT(id_enseignant),
    FOREIGN KEY (id_matiere) REFERENCES MATIERE(id_matiere)
);

-- Table SUIVRE (relation N:N entre ETUDIANT et MATIERE avec note)
CREATE TABLE SUIVRE (
    id_etudiant INT,
    id_matiere INT,
    note DECIMAL(4,2) CHECK (note >= 0 AND note <= 20),
    date_evaluation DATE,
    PRIMARY KEY (id_etudiant, id_matiere),
    FOREIGN KEY (id_etudiant) REFERENCES ETUDIANT(id_etudiant),
    FOREIGN KEY (id_matiere) REFERENCES MATIERE(id_matiere)
);

